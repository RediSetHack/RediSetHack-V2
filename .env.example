PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redisethack
PORT=3001

# Browser origin(s) allowed by CORS; comma-separate several. Defaults to http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Clerk authentication (per ADR 0002)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# Codelab code execution provider (optional, defaults to the public Piston API)
CODE_EXECUTION_API_URL=https://emkc.org/api/v2/piston
# Set true only after verifying provider isolation in a disposable environment.
CODE_EXECUTION_SANDBOX_VERIFIED=false

# Research export (admin-only dataset endpoint); 32+ chars, keep secret
RESEARCH_PSEUDONYM_KEY=
