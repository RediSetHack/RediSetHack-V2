    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
